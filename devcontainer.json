{
    "name": "My Development Container",
    "image": "mcr.microsoft.com/vscode/devcontainers/python:3.9",
    "extensions": [
        "github.copilot",
        "ms-python.python"
    ],
    "settings": {
        "python.pythonPath": "/usr/local/bin/python"
    },
    "postCreateCommand": "pip install -r requirements.txt"
}
